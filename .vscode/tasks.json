{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ file",
            "type": "process",
            "command": "E:\\compilercpp\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}